# ── GoFund — Environment Variables ──────────────────
# Copy this file to .env and fill in the values before running docker-compose up

# Environment: "development" (default) or "production"
# In production, JWT_SECRET and CORS_ALLOWED_ORIGINS are validated at startup.
APP_ENV=development

# Database
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_PORT=5432

# API
API_PORT=8080
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
TOKEN_TTL=72h

# CORS — set to your frontend domain in production
# Example: https://gofund.com.br
CORS_ALLOWED_ORIGINS=*

# Email (Resend)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=GoFund <noreply@gofund.com.br>
# APP_URL=https://gofund.com.br
