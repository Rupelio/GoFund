<template>
  <div>
    <section class="panel-grid"><article class="panel">
      <header class="panel-head"><h2>Contas e Carteiras</h2></header>
      <form class="form-stack" @submit.prevent="handleSubmit">
        <div class="row-2">
          <label>Nome<input v-model="form.name" type="text" placeholder="Ex: Nubank" maxlength="40" required /></label>
          <label>Tipo
            <select v-model="form.type" required>
              <option value="corrente">Corrente</option>
              <option value="poupanca">Poupança</option>
              <option value="carteira">Carteira</option>
              <option value="investimento">Investimento</option>
              <option value="credito">Cartão de Crédito</option>
            </select>
          </label>
        </div>
        <div class="row-2">
          <label>Saldo Inicial<input v-model.number="form.initialBalance" type="number" min="0" step="0.01" /></label>
          <label>Cor<input v-model="form.color" type="color" /></label>
        </div>
        <div class="row-actions">
          <button class="btn primary" type="submit">{{ editingId ? 'Atualizar' : 'Criar Conta' }}</button>
          <button v-if="editingId" class="btn ghost" type="button" @click="cancelEdit">Cancelar</button>
        </div>
      </form>
      <div class="stack-list" style="margin-top:1.25rem">
        <div v-if="!data.accounts.length" class="empty-state">Nenhuma conta cadastrada.</div>
        <div v-for="acc in data.accounts" :key="acc.id" class="account-card" :style="{ borderLeft: `4px solid ${acc.color || '#5e7fff'}` }">
          <div class="account-card-info">
            <strong>{{ acc.name }}</strong>
            <span class="text-muted text-sm">{{ accountTypeLabel(acc.type) }}</span>
          </div>
          <div class="account-card-balance">
            <span>{{ formatCurrency(getBalance(acc.id)) }}</span>
          </div>
          <div class="account-card-actions">
            <button class="btn ghost tiny" @click="editAccount(acc)">✏️</button>
            <button class="btn ghost tiny danger-text" @click="confirmDeleteAccount(acc)">🗑️</button>
          </div>
        </div>
      </div>
    </article></section>

    <!-- Confirm Delete -->
    <div v-if="deleteTarget" class="dialog-backdrop" @click.self="deleteTarget = null">
      <section class="dialog-card" role="dialog">
        <header class="dialog-header"><h3>Confirmar exclusão</h3><button class="dialog-close-btn" type="button" @click="deleteTarget = null">&times;</button></header>
        <div class="dialog-body"><p>Excluir conta "<strong>{{ deleteTarget.name }}</strong>"?</p></div>
        <footer class="dialog-footer">
          <button class="btn ghost tiny" @click="deleteTarget = null">Cancelar</button>
          <button class="btn primary tiny dialog-ok-danger" @click="doDelete">Excluir</button>
        </footer>
      </section>
    </div>
  </div>
</template>

<script setup>
import { ref, computed } from 'vue'
import { useDataStore } from '../stores/data.js'
import { formatCurrency, getAccountBalance } from '../helpers.js'

const data = useDataStore()
const deleteTarget = ref(null)

const form = ref({ name: '', type: 'corrente', initialBalance: 0, color: '#5e7fff' })
const editingId = computed(() => data.editingAccountId)

function accountTypeLabel(type) {
  const labels = { corrente: 'Corrente', poupanca: 'Poupança', carteira: 'Carteira', investimento: 'Investimento', credito: 'Cartão de Crédito' }
  return labels[type] || type
}

function getBalance(id) {
  return getAccountBalance(id, data.accounts, data.transactions)
}

function handleSubmit() {
  data.saveAccount({ ...form.value }).then(ok => { if (ok) resetForm() })
}

function resetForm() {
  form.value = { name: '', type: 'corrente', initialBalance: 0, color: '#5e7fff' }
  data.editingAccountId = null
}

function editAccount(acc) {
  data.editingAccountId = acc.id
  form.value = { name: acc.name, type: acc.type || 'corrente', initialBalance: acc.initialBalance || 0, color: acc.color || '#5e7fff' }
}

function cancelEdit() { resetForm() }
function confirmDeleteAccount(acc) { deleteTarget.value = acc }
function doDelete() { data.deleteAccount(deleteTarget.value.id); deleteTarget.value = null }
</script>
